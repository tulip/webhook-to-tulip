# Tulip instance URL (e.g. https://your-company.tulip.co)
TULIP_INSTANCE_URL=https://your-instance.tulip.co

# Tulip bot API credentials — create in Account Settings > API Tokens
TULIP_API_KEY=
TULIP_API_SECRET=

# Secret for webhook authentication (used by HMAC or bearer auth)
# Leave blank if auth type is "none" in your mapping.json
WEBHOOK_SECRET=

# Optional: Tulip workspace ID (only for multi-workspace instances)
TULIP_WORKSPACE=

# Optional: restrict by source IP (comma-separated IPv4/CIDR)
ALLOWED_SOURCE_IPS=
